{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desk for Hark",
  "version": "1.0.0",
  "identifier": "dev.midnightlab.deskforhark",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "publisher": "MidnightLab",
    "shortDescription": "Desk for Hark: an unofficial Windows app for Hark",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "headerImage": "installer/nsis-header.bmp"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "copyright": "© 2026 MidnightLab. Unofficial; not affiliated with Hark.",
    "license": "MIT"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1REJCMDc5QzE0NDQ0MDEKUldRQlJFVEJlYkRiaFVmelBDUWFnaytmWGNlS3lBa2pPQXZIMndFblFQSjZtblBKV3BMV3l6THQK",
      "endpoints": [
        "https://github.com/MidnightLabDev/desk-for-hark/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}